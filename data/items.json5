{
	// Items: what can be carried, dropped, and put in things (see js/hc/model/Items.js).
	// Included by init.json5.

	// Each has a "name" and a "description", and
	//   plural:    its name for more than one (its name with an "s" if not given)
	//   material:  what it's made of (one of environs.json5's "materials")
	//   volume:    in cubic centimetres
	//   weight:    in grams; if not given, its volume times its material's density
	//              (grams a cubic centimetre)
	//   capacity:  the room it takes in an inventory (1 if not given; 0 takes none)
	//   stack:     the most that make one stack (1 if not given: it doesn't stack)
	//   inventory: if things can be put in it: {"capacity", "weight", "volume"}, the most
	//              it can hold (each without limit if not given). One that holds things
	//              doesn't stack. Its own volume should allow for what it holds.
	//              "fluids":true: it holds fluids (a flask), and only them.
	//   equip:     if a piece can equip it: {"slot", "damage", "penetration", "armor"}.
	//              slot: "weapon", "offhand", "body", "head", "hands" or "feet"; damage: a
	//              weapon's [min, max], in place of the piece's own (its species' or
	//              profile's) while it's its weapon; penetration: a weapon's, in place of
	//              its own (0 if not given); armor: what it adds to the piece's (0 if not
	//              given); cost: the action points equipping or unequipping it takes (the
	//              equipCost rule's if not given). Enemies equip what they're given.
	//   quench, satiates, heals, rests: what a dose of it does to thirst, hunger, HP and
	//              fatigue, if it can be drunk or eaten (below 0 to make them worse: salty
	//              food). Each a number (for any species) or by species, e.g.
	//              {"goblin":100, "hobgoblin":90, "*":5}: a species' own, else that of the
	//              nearest species it extends (a hobgoblin would have a goblin's), else
	//              "*"'s, else 0.
	//   dose:      how many of it a drink or a bite is (1 if not given)
	//   consumeCost: what eating or drinking it costs (the consumeCost rule's if not given)
	//   fluid:     true for a fluid (water): it goes only in what holds fluids, and is
	//              counted in millilitres (its volume is 1)
	//   category:  what sort of thing it is: one of "itemCategories" (below). An inventory
	//              lists what's equipped first, then the rest by category, in that order,
	//              a faint line between each (those without one last)
	// What a species leaves when it dies is one of these (its "corpse" in entities.json5:
	// "corpse" if it doesn't say), holding everything it had, and named for it ("goblin
	// corpse", "creeper husk", "corpse of Tess").
	"itemCategories":["weapon", "armor", "food", "drink", "container", "money", "remains"],
	
	"items":{
		// Money
		"gold_coin":{
			"category":"money",
			"name":"gold coin",
			"description":"Gold: what loot gives, and placing a piece costs.",
			"material":"gold",
			"volume":0.25,
			"stack":100000
		},
		
		// Remains
		"corpse":{
			"category":"remains",
			"name":"corpse",
			"description":"What's left of something that died, and everything it had.",
			"material":"flesh",
			"volume":70000,
			"inventory":{}
		},
		"small_corpse":{
			"extends":"corpse",
			"volume":30000
		},
		"large_corpse":{
			"extends":"corpse",
			"volume":250000
		},
		"husk":{
			"extends":"corpse",
			"name":"husk",
			"description":"The dry shell a creeper leaves.",
			"material":"fungus",
			"volume":20000,
			"weight":3000
		},
		
		// Weapons (from Ouroboros)
		"dagger":{
			"category":"weapon",
			"name":"dagger",
			"description":"A short blade for close work.",
			"material":"steel",
			"volume":65,
			"equip":{"slot":"weapon", "damage":[1, 4], "penetration":1, "cost":0.25}
		},
		"short_sword":{
			"category":"weapon",
			"name":"short sword",
			"description":"A bronze blade, handy in a tight spot.",
			"material":"bronze",
			"volume":150,
			"equip":{"slot":"weapon", "damage":[2, 6], "penetration":1, "cost":0.25}
		},
		"long_sword":{
			"category":"weapon",
			"name":"long sword",
			"description":"A long steel blade.",
			"material":"steel",
			"volume":300,
			"equip":{"slot":"weapon", "damage":[2, 8], "penetration":2, "cost":0.25}
		},
		"club":{
			"category":"weapon",
			"name":"club",
			"description":"A heavy length of ironwood.",
			"material":"ironwood",
			"volume":500,
			"equip":{"slot":"weapon", "damage":[1, 6], "cost":0.25}
		},
		
		// Armour
		"wooden_shield":{
			"category":"armor",
			"name":"wooden shield",
			"description":"A round oak shield.",
			"material":"oakwood",
			"volume":4000,
			"equip":{"slot":"offhand", "armor":1, "cost":0.5}
		},
		"leather_armor":{
			"category":"armor",
			"name":"leather armour",
			"plural":"leather armour",
			"description":"A jerkin of boiled leather.",
			"material":"leather",
			"volume":3000,
			"equip":{"slot":"body", "armor":1, "cost":1}
		},
		"chain_shirt":{
			"category":"armor",
			"name":"chain shirt",
			"description":"Steel rings, heavy but sure.",
			"material":"steel",
			"volume":1200,
			"equip":{"slot":"body", "armor":2, "cost":1}
		},
		"iron_helm":{
			"category":"armor",
			"name":"iron helm",
			"description":"A plain iron cap.",
			"material":"iron",
			"volume":250,
			"equip":{"slot":"head", "armor":1, "cost":0.25}
		},
		"leather_gloves":{
			"category":"armor",
			"name":"leather gloves",
			"plural":"pairs of leather gloves",
			"description":"Worn but supple. No protection to speak of, yet.",
			"material":"leather",
			"volume":300,
			"equip":{"slot":"hands", "cost":0.25}
		},
		"leather_boots":{
			"category":"armor",
			"name":"leather boots",
			"plural":"pairs of leather boots",
			"description":"Sturdy boots. No protection to speak of, yet.",
			"material":"leather",
			"volume":1200,
			"equip":{"slot":"feet", "cost":0.5}
		},
		
		// Food and drink (see js/hc/model/Needs.js)
		"mushroom_jerky":{
			"category":"food",
			"name":"mushroom jerky",
			"plural":"mushroom jerky",
			"description":"Dried strips of cave mushroom. Salty.",
			"material":"fungus",
			"volume":25,
			"stack":20,
			"satiates":100,
			"quench":-20
		},
		"centipede_jerky":{
			"category":"food",
			"name":"centipede jerky",
			"plural":"centipede jerky",
			"description":"Dried giant centipede. Chewy, and saltier still.",
			"material":"flesh",
			"volume":25,
			"stack":20,
			"satiates":150,
			"quench":-30
		},
		// Goblin food: meant for goblins, barely food for anyone else
		"mold_cake":{
			"category":"food",
			"name":"mold cake",
			"description":"A dense cake of cave mold pressed with grease. Goblins love it; anyone else can barely keep it down.",
			"material":"fungus",
			"volume":100,
			"stack":10,
			"satiates":{"goblin":100, "hobgoblin":90, "orc":50, "half_orc":25, "ogre":75, "*":5},
			"heals":{"goblin":0, "orc":0, "half_orc":0, "ogre":0, "*":-1}
		},
		"crawler_stalk":{
			"category":"food",
			"name":"crawler stalk",
			"description":"A pale, fleshy stalk that grows where crawlers nest. Filling, and it knits wounds.",
			"material":"vegetable",
			"volume":60,
			"stack":10,
			"satiates":50,
			"heals":2.5
		},
		"water":{
			"category":"drink",
			"name":"water",
			"plural":"water",
			"description":"Water: a drink is a quarter of a litre.",
			"material":"water",
			"volume":1,
			"stack":1000000,
			"fluid":true,
			"dose":250,
			"quench":250
		},
		
		// Containers
		"flask":{
			"category":"drink",
			"name":"flask",
			"description":"A small tin flask: a quarter of a litre.",
			"material":"tin",
			"volume":300,
			"weight":150,
			"inventory":{"capacity":1, "volume":250, "fluids":true}
		},
		"canteen":{
			"category":"drink",
			"name":"canteen",
			"description":"A tin canteen: a litre.",
			"material":"tin",
			"volume":1100,
			"weight":300,
			"inventory":{"capacity":1, "volume":1000, "fluids":true}
		},
		"water_skin":{
			"category":"drink",
			"name":"water skin",
			"description":"A leather skin: two litres.",
			"material":"leather",
			"volume":2100,
			"weight":250,
			"inventory":{"capacity":1, "volume":2000, "fluids":true}
		},
		"belt_pouch":{
			"category":"container",
			"name":"belt pouch",
			"description":"A small leather pouch.",
			"material":"leather",
			"volume":600,
			"weight":150,
			"inventory":{"capacity":5, "volume":500}
		}
	}
}
