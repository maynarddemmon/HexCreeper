	// Backgrounds: where a creature comes from (see js/hc/model/Combat.js). A name and
	// description; later skills and abilities. "statAdj": what it adds to its species'
	// typical stats ({stat:n}, n below 0 to lower one), the baseline a creature of the two
	// starts from (each kept in the species' range). "playable": whether you can choose it
	// for a character (false if not given). "species": the species it can go with (any, if
	// not given; a species can limit its backgrounds too: a pair fits if each allows the
	// other). Your pieces are the first playable species with the first playable background
	// that fits it, until character creation.
	"backgrounds":{
		"denizen":{
			"name":"Denizen",
			"description":"A denizen of the wilds."
		},
		"urchin":{
			"name":"Urchin",
			"description":"Grew up on the streets: quick fingers, a hard shell, little schooling and less charm.",
			"playable":true,
			"statAdj":{"dex":1, "wil":1, "int":-1, "cha":-1}
		},
		"reaver":{
			"name":"Reaver",
			"description":"You've taken what you want by force.",
			"playable":true,
			"statAdj":{"str":2, "wis":-1, "cha":-1}
		},
		"soldier":{
			"name":"Soldier",
			"description":"Drilled and hardened in a lord's army.",
			"playable":true,
			"statAdj":{"str":1, "con":1, "int":-1, "cha":-1}
		},
		"acolyte":{
			"name":"Acolyte",
			"description":"Raised in a temple, among prayers and old books.",
			"playable":true,
			"statAdj":{"wis":1, "wil":1, "str":-1, "agl":-1}
		},
		"scholar":{
			"name":"Scholar",
			"description":"Years in libraries have sharpened the mind, if not the body.",
			"playable":true,
			"statAdj":{"int":2, "str":-1, "con":-1}
		},
		"noble":{
			"name":"Noble",
			"description":"Born to privilege, trained in manners and command.",
			"playable":true,
			"statAdj":{"cha":2, "con":-1, "wil":-1}
		},
		"hunter":{
			"name":"Hunter",
			"description":"Lived off the land, tracking game through the wild.",
			"playable":true,
			"statAdj":{"wis":1, "dex":1, "int":-1, "cha":-1}
		},
		"thief":{
			"name":"Thief",
			"description":"Made a living from locks, pockets and shadows.",
			"playable":true,
			"statAdj":{"agl":1, "dex":1, "wis":-1, "wil":-1}
		},
		"artisan":{
			"name":"Artisan",
			"description":"Apprenticed to a craft: patient, precise and practical.",
			"playable":true,
			"statAdj":{"dex":1, "int":1, "agl":-1, "cha":-1}
		},
		"hermit":{
			"name":"Hermit",
			"description":"Lived apart for years, alone with your thoughts.",
			"playable":true,
			"statAdj":{"wis":2, "cha":-2}
		},
		"sailor":{
			"name":"Sailor",
			"description":"Hauled ropes and rode out storms on the open sea.",
			"playable":true,
			"statAdj":{"agl":1, "con":1, "int":-1, "wis":-1}
		},
		"entertainer":{
			"name":"Entertainer",
			"description":"Sang, juggled and tumbled for coins in a travelling troupe.",
			"playable":true,
			"statAdj":{"cha":1, "agl":1, "wil":-1, "wis":-1}
		},
		"merchant":{
			"name":"Merchant",
			"description":"Grew up haggling over goods in the market.",
			"playable":true,
			"statAdj":{"cha":1, "int":1, "str":-1, "con":-1}
		},
		"farmhand":{
			"name":"Farmhand",
			"description":"Worked the fields from dawn to dusk.",
			"playable":true,
			"statAdj":{"str":1, "con":1, "int":-1, "cha":-1}
		},
		"clan_smith":{
			"name":"Clan Smith",
			"description":"Learned the forge in the halls of your clan.",
			"playable":true,
			"species":["dwarf", "mountain_dwarf", "gnome"],
			"statAdj":{"str":1, "dex":1, "agl":-1, "cha":-1}
		},
		"forest_warden":{
			"name":"Forest Warden",
			"description":"Kept watch over the old woods and the paths through them.",
			"playable":true,
			"species":["elf", "wood_elf", "high_elf", "half_elf"],
			"statAdj":{"agl":1, "wis":1, "str":-1, "cha":-1}
		},
		"pit_fighter":{
			"name":"Pit Fighter",
			"description":"Fought for coin and crowds in the fighting pits.",
			"playable":true,
			"statAdj":{"str":1, "con":1, "wis":-1, "int":-1}
		}
	},
	
	// Enemies' profiles: what a piece is in a fight (see js/hc/model/Combat.js). "species" (the id
	// of the species it's for, or a list of them, a piece being the first unless it's
	// chosen; it must have one), "backgrounds" (those it can have, one that fits its
	// species chosen at random for each piece: ["denizen"] if not given), "stats" (str, agl,
	// con, dex, int, wis, wil, cha, its own: its species' typical values for any not given,
	// and within all its species' ranges), "level" (1), "damage" ([min, max], its
	// weapon's, before its str bonus: its species' base damage if not given), "penetration" (how much damage reduction its weapon
	// goes through), "armor" (its damage reduction), "hp" (its max HP, if fixed: else the
	// maxHp rule's), for enemies, "xp" (what killing it is worth: else the xpValue rule's),
	// and "items", what it carries (see items.json5): item ids, or {"kind":id, "count":n}
	// for more than one, count also [min, max] (rolled for each piece, so it may have none).
	
	// Named enemies: what a single enemy piece is, by id ("name", "description", and its
	// profile). An enemy without a name is a creeper.
	"enemies":{
		"creeper":{
			"name":"Creeper",
			"description":"Something that crawls out of the dark.",
			"species":"creeper",
			"hp":4,
			"xp":4
		},
		"goblin":{
			"name":"Goblin",
			"description":"A small humanoid with green skin, big eyes and sharp teeth.",
			"species":"goblin",
			"backgrounds":["urchin","denizen"],
			"hp":5,
			"xp":5,
			"items":[{"kind":"mushroom_jerky", "count":[0, 2]}]
		},
		"goblin_reaver":{
			"extends":"goblin",
			"name":"Goblin Reaver",
			"backgrounds":["reaver"],
			"description":"A goblin with a cruel blade.",
			"stats":{"str":12, "con":12},
			"hp":8,
			"xp":10,
			"items":["short_sword", {"kind":"mushroom_jerky", "count":[0, 2]}]
		},
		"hobgoblin":{
			"name":"Hobgoblin",
			"description":"A big goblin with a menacing stare.",
			"species":"hobgoblin",
			"backgrounds":["urchin","denizen","pit_fighter"],
			"hp":8,
			"xp":10,
			"items":["club", {"kind":"centipede_jerky", "count":[0, 3]}]
		},
		"hobgoblin_reaver":{
			"name":"Hobgoblin Reaver",
			"description":"A big goblin with a cruel blade.",
			"species":"hobgoblin",
			"backgrounds":["reaver"],
			"hp":13,
			"xp":15,
			"items":["long_sword", "belt_pouch"]
		},
	},
	
	// Enemies as they come, linked into trees ("name", "description", "members"). members
	// is a list of nodes, each an enemy's id (one piece, on its own), {"<enemy id>":[nodes]}
	// for an enemy with those linked below it, or a group's id, standing for all its trees
	// (so a group can't have nodes below it). An id names an enemy or a group, not both. A
	// spawn generator's table can name either (see js/hc/model/Enemies.js).
	"enemyGroups":{
		"goblin_pair":{
			"name":"Goblin Pair",
			"description":"A pair of goblins.",
			"members":[{"goblin":["goblin"]}]
		},
		"goblin_trio":{
			"name":"Goblin Trio",
			"description":"A trio of goblins.",
			"members":[{"goblin_reaver":["goblin", "goblin"]}]
		},
		"goblin_pack":{
			"name":"Goblin Pack",
			"description":"A pack of goblins: a leader and three trios.",
			"members":[{"goblin_reaver":["goblin_trio", "goblin_trio", "goblin_trio"]}]
		},
		"goblin_horde":{
			"name":"Goblin Horde",
			"description":"A horde of goblins.",
			"members":[
				"goblin_pack",
				"goblin_trio","goblin_trio",
				"goblin_pair","goblin_pair","goblin_pair",
				"goblin","goblin","goblin","goblin","goblin","goblin","goblin"
			]
		}
	}
}
