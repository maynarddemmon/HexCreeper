				"wil":[3, 10, 18], 
				"cha":[3, 10, 18]
			}
		},
		"high_elf":{
			"extends":"elf",
			"name":"High Elf",
			"description":"Elves of the old cities: learned, proud and strong-willed.",
			"stats":{
				"agl":[3, 10, 18],
