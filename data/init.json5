{
	// The map played when there's no saved game.
	"defaultMap":"endless",
	
	// Materials solids are made of. hardness is the damage reduction (DR) of a solid made of
	// it: an attack does the attacker's rank less the DR. density isn't used yet. opacity
	// (0-100, default 100) is how much it blocks sight: 100 blocks it, 0 not at all, and in
	// between, sight past it is shortened (see docs/DESIGN.md, Fog of war).
	"materials":{
		// Organic
		"flesh":    {"name":"flesh",     "hardness":0, "density":0.95, "description":""},
		"fungus":   {"name":"fungus",    "hardness":0, "density":0.9,  "description":""},
		"vegetable":{"name":"vegetable", "hardness":0, "density":0.9,  "description":""},
		
		// Wood
		"pinewood":{"name":"pine",     "hardness":4, "density":0.5,  "description":""},
		"oakwood": {"name":"oak",      "hardness":5, "density":0.75, "description":""},
		"ironwood":{"name":"ironwood", "hardness":7, "density":1.25, "description":""},
		
		// Metal
		"tin":      {"name":"tin",       "hardness":10, "density":7.27,  "description":"Tin is a soft silvery-white metal"},
		"iron":     {"name":"iron",      "hardness":17, "density":7.87,  "description":"Iron is a soft, silver-white or gray, metal"},
		"steel":    {"name":"steel",     "hardness":20, "density":7.9,   "description":"Steel is an alloy of iron and carbon with improved strength and fracture resistance"},
		"copper":   {"name":"copper",    "hardness":12, "density":8.96,  "description":"Copper is a reddish lustrous metal"},
		"bronze":   {"name":"bronze",    "hardness":14, "density":8.5,   "description":"Bronze is an alloy of copper and tin"},
		"brass":    {"name":"brass",     "hardness":14, "density":8.5,   "description":"Brass is an alloy of copper and zinc"},
		"silver":   {"name":"silver",    "hardness":10, "density":10.49, "description":"Silver is a white metal with brilliant metallic luster"},
		"gold":     {"name":"gold",      "hardness":7,  "density":19.3,  "description":"Gold is a lustrous, ductile, and malleable, yellow metal"},
		"platinum": {"name":"platinum",  "hardness":6,  "density":21.45, "description":"Platinum is a lustrous, ductile, and malleable, silver-white metal"},
		"palladium":{"name":"palladium", "hardness":8,  "density":12.01, "description":"Palladium is a lustrous, ductile, and malleable, silver-white metal"},
		"nickel":   {"name":"nickel",    "hardness":8,  "density":8.91,  "description":"Nickel is a silvery-white lustrous metal with a slight golden tinge"},
		"lead":     {"name":"lead",      "hardness":6,  "density":11.4,  "description":"Lead is a very soft silvery grey metal with bright luster"},
		
		// Stone
		"alabaster": {"name":"alabaster",  "hardness":6,  "density":10, "description":""},
		"soapstone": {"name":"soapstone",  "hardness":5,  "density":10, "description":""},
		"sandstone": {"name":"sandstone",  "hardness":5,  "density":10, "description":""},
		"limestone": {"name":"limestone",  "hardness":8,  "density":10, "description":""},
		"granite":   {"name":"granite",    "hardness":13, "density":10, "description":""},
		"marble":    {"name":"marble",     "hardness":8,  "density":10, "description":""},
		"basalt":    {"name":"basalt",     "hardness":8,  "density":10, "description":""},
		"serpentine":{"name":"serpentine", "hardness":7,  "density":10, "description":""},
		"calcite":   {"name":"calcite",    "hardness":3,  "density":2.7, "description":"Calcite is the mineral stalagmites and stalactites are made of"},
		"rubble":    {"name":"rubble",     "hardness":2,  "density":1.6, "description":"Loose broken rock, as from a collapse"},
		
		// See-through
		"glass":  {"name":"glass",   "hardness":3, "density":2.5,  "opacity":10, "description":""},
		"ice":    {"name":"ice",     "hardness":2, "density":0.92, "opacity":50, "description":""},
		"crystal":{"name":"crystal", "hardness":9, "density":2.65, "opacity":15, "description":""},
		"plastic":{"name":"plastic", "hardness":3, "density":1.2,  "opacity":30, "description":""},
		
		// Fibre
		"rope":{"name":"rope", "hardness":1, "density":0.9, "description":""}
	},
	
	// Kinds of solid tile: what each is made of ("composition", a material above) and its
	// hit points, and optionally the colours it's drawn in ("fillColor" and "borderColor":
	// any CSS colour, or a --variable from index.html); without them it's the usual grey.
	// "coverage" (0-100, default 100) is how much of the cell the material fills, e.g. bars
	// or a net: its opacity is its material's times its coverage. A solid that can be seen
	// through is drawn see-through too.
	// Maps choose which kinds walls, clumps and cave rock are made of (their tile
	// generator's attrs; see js/hc/model/map/tile/ProximityTileGenerator.js and
	// CavernsTileGenerator.js).
	"solids":{
		"stone_wall":      {"name":"Granite wall",     "composition":"granite",   "hp":30},
		"boulder":         {"name":"Boulder",          "composition":"basalt",    "hp":12},
		"wall_of_stone":   {"name":"Stone wall",       "composition":"basalt",    "hp":12},
		"sandstone_wall":  {"name":"Sandstone wall",   "composition":"sandstone", "hp":20, "fillColor":"#b49870", "borderColor":"#c9ae86"},
		"wooden_barricade":{"name":"Wooden barricade", "composition":"pinewood",  "hp":8,  "fillColor":"#7a5a3c", "borderColor":"#92704f"},
		"wall_of_iron":    {"name":"Wall of iron",     "composition":"iron",      "hp":15, "fillColor":"#5c6168", "borderColor":"#7c838c"},
		"wall_of fungus":  {"name":"Wall of fungus",   "composition":"fungus",    "hp":3,  "fillColor":"#6e5c7e", "borderColor":"#8a76a0"},
		"wall_of_flesh":   {"name":"Wall of flesh",    "composition":"flesh",     "hp":6,  "fillColor":"#9c5058", "borderColor":"#b6666f"},
		"hedge":           {"name":"Hedge",            "composition":"vegetable", "hp":4,  "fillColor":"#3e6a3a", "borderColor":"#518447"},
		"glass_wall":      {"name":"Glass wall",       "composition":"glass",     "hp":4,  "fillColor":"#9cc8d8", "borderColor":"#c4e4ee"},
		"ice_wall":        {"name":"Ice wall",         "composition":"ice",       "hp":6,  "fillColor":"#cfe6f0", "borderColor":"#e8f4f8"},
		"crystal_wall":    {"name":"Crystal wall",     "composition":"crystal",   "hp":20, "fillColor":"#c8b8e8", "borderColor":"#e0d4f6"},
		"plastic_wall":    {"name":"Plastic wall",     "composition":"plastic",   "hp":6,  "fillColor":"#d8d0b0", "borderColor":"#ece6cc"},
		"iron_bars":       {"name":"Iron bars",        "composition":"iron",      "hp":10, "coverage":20, "fillColor":"#5c6168", "borderColor":"#7c838c"},
		"net":             {"name":"Net",              "composition":"rope",      "hp":3,  "coverage":30, "fillColor":"#8a7a5a", "borderColor":"#a8966e"},
		// Caverns (see js/hc/model/map/tile/CavernsTileGenerator.js). A stalactite hangs from the
		// ceiling, so you can see past it more than a stalagmite, and over a pile of rubble
		// a little.
		"cave_rock":       {"name":"Cave rock",        "composition":"limestone", "hp":40, "fillColor":"#57504a", "borderColor":"#6b645c"},
		"stalagmite":      {"name":"Stalagmite",       "composition":"calcite",   "hp":8,  "fillColor":"#9a8f7e", "borderColor":"#b3a894"},
		"stalactite":      {"name":"Stalactite",       "composition":"calcite",   "hp":6,  "coverage":40, "fillColor":"#a89c88", "borderColor":"#c0b49e"},
		"rubble":          {"name":"Rubble",           "composition":"rubble",    "hp":6,  "coverage":70, "fillColor":"#7a6f63", "borderColor":"#8f8476"},
		"icicle":          {"name":"Icicle",           "composition":"ice",       "hp":3,  "fillColor":"#cfe6f0", "borderColor":"#e8f4f8"},
		"ice_boulder":     {"name":"Ice Boulder",      "composition":"ice",       "hp":6,  "fillColor":"#cfe6f0", "borderColor":"#e8f4f8"}
	},
	
	// Kinds of hole tile: a name, a description and optionally the colour it's filled with
	// ("fillColor": any CSS colour, or a --variable from index.html); without it it's the
	// usual near-black.
	"holes":{
		"pit":     {"name":"Pit",      "description":"A deep pit. Nothing can cross it, but you can see over it.", "fillColor":"#333"},
		"chasm":   {"name":"Chasm",    "description":"A crack in the ground too wide to jump.", "fillColor":"#282828"},
		"sinkhole":{"name":"Sinkhole", "description":"The ground has fallen away here.",        "fillColor":"#383838"}
	},
	
	// Kinds of heal, harm and loot tile. Each has a name, a description, and how it works
	// (see js/hc/model/tile/EffectTiles.js for the details):
	//   revealMode: when it shows: "instant" (default: once its cell is in sight),
	//     "hidden" (once a piece of yours enters it) or {"proximity":n} (once a piece of
	//     yours is within n cells).
	//   pool: what it holds (HP, damage or score): n, {"min":n, "max":n} (rolled when it's
	//     made) or "infinite".
	//   magnitude: what it gives each piece it affects, each time: n, {"min","max"} or
	//     "pool" (default: all that's left).
	//   showMagnitude: when its magnitude shows, as revealMode ("hidden": once used).
	//   showPool: whether what's left in it shows (default false).
	//   area: who it affects when a piece of yours enters it: a radius (default 0: just
	//     that piece) or {"radius":n, "shape":"flat" | "ring" | "fade"}.
	//   duration: when it's gone: "exhausted" (default: when its pool is empty), "once",
	//     {"count":n} (after n uses) or {"countdown":n} (n turns after it's revealed).
	// Maps choose which kinds their tiles are (their tile generator's attrs; see
	// js/hc/model/map/tile/ProximityTileGenerator.js and CavernsTileGenerator.js).
	"heals":{
		"heal": {
			"name":"Heal",
			"description":"Heals the piece that takes it; what it doesn't need flows along its links.",
			"pool":{"min":1, "max":4}
		},
		"spring":{
			"name":"Healing spring", 
			"description":"Heals 1 each time, for as long as it lasts.", 
			"pool":"infinite", 
			"magnitude":1, 
			"duration":{"countdown":10}
		},
		"salve": {
			"name":"Salve",
			"description":"Heals every piece of yours next to it.",
			"pool":6,
			"magnitude":2,
			"area":1,
			"showPool":true
		}
	},
	"harms":{
		"harm":{
			"name":"Harm",
			"description":"Hurts whatever piece of yours steps on it.",
			"pool":1
		},
		"trap":{
			"name":"Hidden trap",
			"description":"You only find it by stepping on it.",
			"revealMode":"hidden",
			"pool":2
		},
		"mine":{
			"name":"Mine",
			"description":"Blasts every piece around it, less further out.",
			"revealMode":{"proximity":2},
			"pool":"infinite",
			"magnitude":2,
			"area":{"radius":1, "shape":"fade"},
			"duration":"once"
		}
	},
	"loots":{
		"loot":{
			"name":"Loot",
			"description":"Score for the taking.",
			"pool":{"min":10, "max":30}
		},
		"cache":{
			"name":"Cache",
			"description":"Buried: you have to be close to find it, and closer to tell what's in it.",
			"revealMode":{"proximity":2},
			"pool":{"min":30, "max":60},
			"showMagnitude":{"proximity":1}
		}
	},
	
	// The rules of combat and action points (see js/hc/model/Combat.js), as formulas: numbers,
	// + - * / % ^, parentheses, and min max floor ceil round sqrt log abs. They're the
	// defaults for every map (a map's own "rules" can change them, for it). Most are of a
	// piece's "level" and stats (str agl con dex int wis wil cha), and are rounded down.
	"rules":{
		// HP and levels
		"maxHp":"10 + con / 2 + (level - 1) * (2 + con / 5)", // unless its profile fixes its hp
		"xpToLevel":"20 * level",                          // the xp to go up from this level
		"xpValue":"5 * level",                             // what killing an enemy is worth, unless its profile says
		
		// An attack: a d100 roll hits if it's no more than hitChance (in %, of the attacker's
		// accuracy and the target's defence, kept from hitMin to hitMax).
		"meleeAccuracy":"str + level",
		"defence":"agl + level",
		"hitChance":"50 + 3 * (accuracy - defence)",
		"hitMin":5,
		"hitMax":95,
		// Then the damage: damageRoll, of the weapon's range ("min" and "max", each with
		// damageBonus, never below 0) and two rolls ("roll" and "roll2", each from 0 up to 1),
		// less the target's armor after penetration (the weapon's, plus penetrationBonus if
		// more than 0). E.g. "min + floor((roll + roll2) * (max - min + 1) / 2)" for two dice.
		"damageRoll":"min + floor(roll * (max - min + 1))",
		"damageBonus":"(str - 10) / 2",
		"penetrationBonus":"(str - 10) / 4",
		
		// Action points, in points (not rounded: kept in hundredths). A pool is at least a
		// point, and an action; an action or a jump costs at least 0.1.
		"apPool":"1 + con / 10",          // the most a piece can have
		"apRecovery":"0.5 + agl / 40",    // what it gets back at the end of each turn
		"apInitiative":"(wis + agl) / 40", // what it gets when an enemy first comes into your sight
		"actionCost":"1",                 // what an action costs (a step, an attack, a swap, a detach or attach)
		"jumpCost":"2"                    // and a jump
	},
	
	// Profiles: what a piece is in a fight (see js/hc/model/Combat.js). "stats" (str, agl,
	// con, dex, int, wis, wil, cha: 10 if not given), "level" (1), "damage" ([min, max], its
	// weapon's, before its str bonus), "penetration" (how much damage reduction its weapon
	// goes through), "armor" (its damage reduction), "hp" (its max HP, if fixed: else the
	// maxHp rule's) and, for enemies, "xp" (what killing it is worth: else the xpValue rule's).
	
	// Your pieces: all adventurers for now.
	"characters":{
		"adventurer":{
			"name":"Adventurer",
			"description":"Someone setting out to see what's down there.",
			"damage":[1, 6]
		}
	},
	
	// Named enemies: what a single enemy piece is, by id ("name", "description", and its
	// profile). An enemy without a name is a creeper.
	"enemies":{
		"creeper":{
			"name":"Creeper",
			"description":"Something that crawls out of the dark.",
			"stats":{"str":8, "agl":8, "con":8},
			"damage":[1, 4],
			"hp":4,
			"xp":4
		},
		"goblin":{
			"name":"Goblin",
			"description":"A small humanoid with green skin, big eyes and sharp teeth.",
			"stats":{"str":8, "agl":12, "con":8, "dex":10, "int":6, "wis":8, "wil":6, "cha":6},
			"damage":[1, 4],
			"hp":5,
			"xp":5
		}
	},
	
	// Enemies as they come, linked into trees ("name", "description", "members"). members
	// is a list of nodes, each an enemy's id (one piece, on its own), {"<enemy id>":[nodes]}
	// for an enemy with those linked below it, or a group's id, standing for all its trees
	// (so a group can't have nodes below it). An id names an enemy or a group, not both. A
	// spawn generator's table can name either (see js/hc/model/Enemies.js).
	"enemyGroups":{
		"goblin_pair":{
			"name":"Goblin Pair",
			"description":"A pair of goblins.",
			"members":[{"goblin":["goblin"]}]
		},
		"goblin_trio":{
			"name":"Goblin Trio",
			"description":"A trio of goblins.",
			"members":[{"goblin":["goblin", "goblin"]}]
		},
		"goblin_pack":{
			"name":"Goblin Pack",
			"description":"A pack of goblins: a leader and three trios.",
			"members":[{"goblin":["goblin_trio", "goblin_trio", "goblin_trio"]}]
		},
		"goblin_horde":{
			"name":"Goblin Horde",
			"description":"A horde of goblins.",
			"members":[
				"goblin_pack",
				"goblin_trio","goblin_trio",
				"goblin_pair","goblin_pair","goblin_pair",
				"goblin","goblin","goblin","goblin","goblin","goblin","goblin"
			]
		}
	},
	
	// Every map, in the order the Maps dialog lists them, with what a list of maps
	// needs. Each map's own file is data/gamemap/<id>.json5. A map with no "number" is
	// listed without one. A map's file names its "tileGenerator", "spawnGenerator" and
	// "enemyAI", {"type":..., ...attrs}, and may give "rules", {id:value}: gameplay values in place of
	// hc.cfg's (see js/hc/model/map/Maps.js), a "seed", so it's always laid out the same
	// (otherwise the brief offers a random one), and "goals" and "penalties" (see
	// docs/DESIGN.md, Maps).
	"maps":[
		{
			"id":"endless",
			"name":"Endless Play",
			"description":"No goals and no end. Grow your swarm and see how long you last."
		},{
			"id":"open_ground",
			"number":1,
			"name":"Open Ground",
			"description":"Wide open country with nowhere to hide, and the enemy comes often."
		},{
			"id":"warrens",
			"number":2,
			"name":"The Warrens",
			"description":"Small chambers joined by narrow doors. You won't see much coming."
		},{
			"id":"hedge_maze",
			"number":3,
			"name":"Hedge Maze",
			"description":"A maze of hedges."
		},{
			"id":"caverns",
			"number":4,
			"name":"Caverns",
			"description":"Caverns deep in the rock, joined by winding tunnels."
		},{
			"id":"ice_caverns",
			"number":5,
			"name":"Ice Caverns",
			"description":"Caverns deep in the ice, joined by twisty tunnels."
		},{
			"id":"empty_caverns",
			"number":6,
			"name":"Empty Caverns",
			"description":"Empty Caverns deep in the rock, joined by winding tunnels."
		},{
			"id":"empty_ice_caverns",
			"number":7,
			"name":"Empty Ice Caverns",
			"description":"Empty Caverns deep in the ice, joined by twisty tunnels."
		}
	]
}
