{
	// The other files whose tables (their top-level properties) make up the game's data,
	// with this one's, in this directory: each may include others in turn, so a file can
	// be split further (environs.json5 into solids.json5, holes.json5... say). No table may
	// be in two of them. See js/hc/model/map/Maps.js.
	"include":["rules.json5", "environs.json5", "items.json5", "entities.json5"],
	
	// Any entry in the tables below (materials, solids, holes, floors, fixtures, items,
	// species, backgrounds, enemies; not enemy groups) may extend another in the same table:
	// "extends":"<id>" starts it as that one, with its own properties over it. Objects (like
	// "stats") merge a property at a time; anything else (text, numbers, arrays like
	// "damage") replaces the parent's. An entry may extend one that extends another, and so
	// on. See js/hc/model/tile/Subtypes.js.
	
	// Every map, in the order the Maps dialog lists them, with what a list of maps
	// needs. Each map's own file is data/gamemap/<id>.json5. A map with no "number" is
	// listed without one. A map's file names its "tileGenerator", "spawnGenerator" and
	// "enemyAI", {"type":..., ...attrs}, and may give "rules", {id:value}: gameplay values in place of
	// hc.cfg's (see js/hc/model/map/Maps.js), a "seed", so it's always laid out the same
	// (otherwise the brief offers a random one), and "goals" and "penalties" (see
	// docs/DESIGN.md, Maps).
	"maps":[
		{
			"id":"endless",
			"name":"Endless Play",
			"description":"No goals and no end. Grow your swarm and see how long you last."
		},{
			"id":"open_ground",
			"number":1,
			"name":"Open Ground",
			"description":"Wide open country with nowhere to hide, and the enemy comes often."
		},{
			"id":"warrens",
			"number":2,
			"name":"The Warrens",
			"description":"Small chambers joined by narrow doors. You won't see much coming."
		},{
			"id":"hedge_maze",
			"number":3,
			"name":"Hedge Maze",
			"description":"A maze of hedges."
		},{
			"id":"caverns",
			"number":4,
			"name":"Caverns",
			"description":"Caverns deep in the rock, joined by winding tunnels."
		},{
			"id":"ice_caverns",
			"number":5,
			"name":"Ice Caverns",
			"description":"Caverns deep in the ice, joined by twisty tunnels."
		},{
			"id":"empty_caverns",
			"number":6,
			"name":"Empty Caverns",
			"description":"Empty Caverns deep in the rock, joined by winding tunnels."
		},{
			"id":"empty_ice_caverns",
			"number":7,
			"name":"Empty Ice Caverns",
			"description":"Empty Caverns deep in the ice, joined by twisty tunnels."
		}
	],
	
	// The map played when there's no saved game.
	"defaultMap":"caverns"
}
