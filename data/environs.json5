{
	// The light that solids and holes cast shadows from (see js/hc/model/tile/Solids.js):
	// "angle" (degrees clockwise from pointing right: 90 is straight down), "color", "blur"
	// (px) and "length" (in hexes: a solid or hole subtype's "shadowLength" goes over it).
	"shadow":{"angle":120, "color":"#0002", "blur":0, "length":0.35},
	
	// What the maps are made of: materials, solids, the light, holes, floors, fixtures, and
	// status effects. Included by init.json5.
	
	// Materials solids are made of. hardness is the damage reduction (DR) of a solid made of
	// it: an attack does the attacker's damage less the DR (after its penetration). density isn't used yet. opacity
	// (0-100, default 100) is how much it blocks sight: 100 blocks it, 0 not at all, and in
	// between, sight past it is shortened (see docs/DESIGN.md, Fog of war).
	"materials":{
		// Organic
		"flesh":    {"name":"flesh",     "hardness":0, "density":0.95, "description":""},
		"fungus":   {"name":"fungus",    "hardness":0, "density":0.9,  "description":""},
		"vegetable":{"name":"vegetable", "hardness":0, "density":0.9,  "description":""},
		"leather":  {"name":"leather",   "hardness":1, "density":0.86, "description":""},
		"water":    {"name":"water",     "hardness":0, "density":1.0,  "description":""},
		"cloth":    {"name":"cloth",     "hardness":0, "density":0.5,  "description":""},
		
		// Wood
		"pinewood":{"name":"pine",     "hardness":4, "density":0.5,  "description":""},
		"oakwood": {"name":"oak",      "hardness":5, "density":0.75, "description":""},
		"ironwood":{"name":"ironwood", "hardness":7, "density":1.25, "description":""},
		
		// Metal
		"tin":      {"name":"tin",       "hardness":10, "density":7.27,  "description":"Tin is a soft silvery-white metal"},
		"iron":     {"name":"iron",      "hardness":17, "density":7.87,  "description":"Iron is a soft, silver-white or gray, metal"},
		"steel":    {"name":"steel",     "hardness":20, "density":7.9,   "description":"Steel is an alloy of iron and carbon with improved strength and fracture resistance"},
		"copper":   {"name":"copper",    "hardness":12, "density":8.96,  "description":"Copper is a reddish lustrous metal"},
		"bronze":   {"name":"bronze",    "hardness":14, "density":8.5,   "description":"Bronze is an alloy of copper and tin"},
		"brass":    {"name":"brass",     "hardness":14, "density":8.5,   "description":"Brass is an alloy of copper and zinc"},
		"silver":   {"name":"silver",    "hardness":10, "density":10.49, "description":"Silver is a white metal with brilliant metallic luster"},
		"gold":     {"name":"gold",      "hardness":7,  "density":19.3,  "description":"Gold is a lustrous, ductile, and malleable, yellow metal"},
		"platinum": {"name":"platinum",  "hardness":6,  "density":21.45, "description":"Platinum is a lustrous, ductile, and malleable, silver-white metal"},
		"palladium":{"name":"palladium", "hardness":8,  "density":12.01, "description":"Palladium is a lustrous, ductile, and malleable, silver-white metal"},
		"nickel":   {"name":"nickel",    "hardness":8,  "density":8.91,  "description":"Nickel is a silvery-white lustrous metal with a slight golden tinge"},
		"lead":     {"name":"lead",      "hardness":6,  "density":11.4,  "description":"Lead is a very soft silvery grey metal with bright luster"},
		
		// Stone
		"alabaster": {"name":"alabaster",  "hardness":6,  "density":10, "description":""},
		"soapstone": {"name":"soapstone",  "hardness":5,  "density":10, "description":""},
		"sandstone": {"name":"sandstone",  "hardness":5,  "density":10, "description":""},
		"limestone": {"name":"limestone",  "hardness":8,  "density":10, "description":""},
		"granite":   {"name":"granite",    "hardness":13, "density":10, "description":""},
		"marble":    {"name":"marble",     "hardness":8,  "density":10, "description":""},
		"basalt":    {"name":"basalt",     "hardness":8,  "density":10, "description":""},
		"serpentine":{"name":"serpentine", "hardness":7,  "density":10, "description":""},
		"calcite":   {"name":"calcite",    "hardness":3,  "density":2.7, "description":"Calcite is the mineral stalagmites and stalactites are made of"},
		"rubble":    {"name":"rubble",     "hardness":2,  "density":1.6, "description":"Loose broken rock, as from a collapse"},
		
		// See-through
		"glass":  {"name":"glass",   "hardness":3, "density":2.5,  "opacity":10, "description":""},
		"ice":    {"name":"ice",     "hardness":2, "density":0.92, "opacity":50, "description":""},
		"crystal":{"name":"crystal", "hardness":9, "density":2.65, "opacity":15, "description":""},
		"plastic":{"name":"plastic", "hardness":3, "density":1.2,  "opacity":30, "description":""},
		
		// Fibre
		"rope":{"name":"rope", "hardness":1, "density":0.9, "description":""}
	},
	
	// Kinds of solid tile: what each is made of ("composition", a material above) and its
	// hit points, and optionally the colours it's drawn in ("fillColor" and "borderColor":
	// any CSS colour, or a --variable from index.html); without them it's the usual grey.
	// "coverage" (0-100, default 100) is how much of the cell the material fills, e.g. bars
	// or a net: its opacity is its material's times its coverage. A solid that can be seen
	// through is drawn see-through too. "floor" is the floor it leaves when it's broken
	// (else the map's base floor). "shadowLength" is how far its shadow reaches, in
	// hexes (else the shadow's length): how tall it is. Its shadow is as dark as its
	// coverage.
	// Maps choose which kinds walls, clumps and cave rock are made of (their tile
	// generator's attrs; see js/hc/model/map/tile/ProximityTileGenerator.js and
	// CavernsTileGenerator.js).
	"solids":{
		"stone_wall":      {"name":"Granite wall",     "composition":"granite",   "hp":30, "floor":"loose_stone"},
		"boulder":         {"name":"Boulder",          "composition":"basalt",    "hp":12, "floor":"loose_stone"},
		"wall_of_stone":   {"name":"Stone wall",       "composition":"basalt",    "hp":12, "floor":"loose_stone"},
		"sandstone_wall":  {"name":"Sandstone wall",   "composition":"sandstone", "hp":20, "fillColor":"#b49870", "borderColor":"#c9ae86", "floor":"loose_stone"},
		"wooden_barricade":{"name":"Wooden barricade", "composition":"pinewood",  "hp":8,  "fillColor":"#7a5a3c", "borderColor":"#92704f"},
		"wall_of_iron":    {"name":"Wall of iron",     "composition":"iron",      "hp":15, "fillColor":"#5c6168", "borderColor":"#7c838c"},
		"wall_of fungus":  {"name":"Wall of fungus",   "composition":"fungus",    "hp":3,  "fillColor":"#6e5c7e", "borderColor":"#8a76a0"},
		"wall_of_flesh":   {"name":"Wall of flesh",    "composition":"flesh",     "hp":6,  "fillColor":"#9c5058", "borderColor":"#b6666f"},
		"hedge":           {"name":"Hedge",            "composition":"vegetable", "hp":4,  "fillColor":"#3e6a3a", "borderColor":"#518447", "floor":"dirt_floor"},
		"glass_wall":      {"name":"Glass wall",       "composition":"glass",     "hp":4,  "fillColor":"#9cc8d8", "borderColor":"#c4e4ee"},
		"ice_wall":        {"name":"Ice wall",         "composition":"ice",       "hp":6,  "fillColor":"#9cf", "borderColor":"#e8f4f8", "floor":"ice"},
		"crystal_wall":    {"name":"Crystal wall",     "composition":"crystal",   "hp":20, "fillColor":"#c8b8e8", "borderColor":"#e0d4f6"},
		"plastic_wall":    {"name":"Plastic wall",     "composition":"plastic",   "hp":6,  "fillColor":"#d8d0b0", "borderColor":"#ece6cc"},
		"iron_bars":       {"name":"Iron bars",        "composition":"iron",      "hp":10, "coverage":20, "fillColor":"#5c6168", "borderColor":"#7c838c"},
		"net":             {"name":"Net",              "composition":"rope",      "hp":3,  "coverage":30, "fillColor":"#8a7a5a", "borderColor":"#a8966e"},
		// Caverns (see js/hc/model/map/tile/CavernsTileGenerator.js). A stalactite hangs from the
		// ceiling, so you can see past it more than a stalagmite, and over a pile of rubble
		// a little.
		"cave_rock":       {"name":"Cave rock",        "composition":"limestone", "hp":40, "fillColor":"#57504a", "borderColor":"#6b645c", "floor":"loose_stone"},
		"stalagmite":      {"name":"Stalagmite",       "composition":"calcite",   "hp":8,  "fillColor":"#9a8f7e", "borderColor":"#b3a894", "floor":"loose_stone"},
		"stalactite":      {"name":"Stalactite", "extends":"stalagmite", "hp":6, "coverage":40},
		"rubble":          {"name":"Rubble",           "composition":"rubble",    "hp":6,  "coverage":70, "fillColor":"#7a6f63", "borderColor":"#8f8476", "floor":"loose_stone"},
		"ice_boulder":     {"name":"Ice Boulder", "extends":"ice_wall"},
		"icicle":          {"name":"Icicle",      "extends":"ice_boulder", "hp":3}
	},
	
	// Kinds of hole tile: a name, a description and optionally the colour it's filled with
	// ("fillColor": any CSS colour, or a --variable from index.html); without it it's the
	// usual near-black. "shadowLength" is how far its near rim's shadow reaches into it,
	// in hexes (else the shadow's length).
	"holes":{
		"pit":     {"name":"Pit",      "description":"A deep pit. Nothing can cross it, but you can see over it.", "fillColor":"#333"},
		"chasm":   {"name":"Chasm",    "description":"A crack in the ground too wide to jump.", "fillColor":"#282828"},
		"sinkhole":{"name":"Sinkhole", "description":"The ground has fallen away here.",        "fillColor":"#383838"}
	},
	
	// Kinds of floor tile: open floor that's harder going. Nothing is blocked (sight,
	// movement), but a step onto one costs "moveCost" (default 1, at least 0.1) times an
	// action, and a group steps at the cost of the dearest cell any of it lands on, never
	// more than a piece's whole pool. Jumps don't pay it. "fillColor" (any CSS colour, or a
	// --variable from index.html) is what it's drawn in; without it it's the usual floor. A
	// cell with no tile is its map's base floor (its tile generator's "baseFloor"), drawn
	// under everything.
	"floors":{
		// Base floors
		"stone_floor": {"name":"Stone floor",  "description":"Plain stone.",                   "fillColor":"--bg"},
		"cave_floor":  {"name":"Cave floor",   "description":"The rock floor of the caves.",   "fillColor":"#46423e"},
		"dirt_floor":  {"name":"Dirt floor",   "description":"Packed earth.",                  "fillColor":"#48413a"},
		"frozen_floor":{"name":"Frozen floor", "description":"Rock under a crust of frost.",   "fillColor":"#678"},
		// Harder going
		"loose_stone":{"name":"Loose stone", "description":"Rocks that shift underfoot.",        "moveCost":1.5, "fillColor":"#4e4b47"},
		"mud":        {"name":"Mud",         "description":"Thick mud that sucks at your feet.", "moveCost":1.75,"fillColor":"#4a3f33"},
		"ice":        {"name":"Ice",         "description":"Slick ice.",                         "moveCost":1.5, "fillColor":"#8ac"},
		// Water
		"stream":       {"name":"Stream",        "description":"Shallow running water.",         "moveCost":1.5, "fillColor":"#039", "fluid":"water"},
		"stream_frozen":{"name":"Frozen Stream", "extends":"ice", "description":"A stream frozen solid."},
		"pool":         {"name":"Pool",          "description":"A pool of water.",               "moveCost":2.0, "fillColor":"#039", "fluid":"water"}
	},
	
	// Fixtures: what sits on the ground of a cell (over its open floor), and may do something
	// when a piece of yours enters it. Each has a name, a description, a "type" ("heal":
	// heals your pieces, "harm": hurts, "loot": gold, "feature": nothing, but it may be in
	// the way; the game goes by the type, e.g. pieces keep off harm) and how it works (see
	// js/hc/model/tile/Fixtures.js):
	//   revealMode: when it shows: "instant" (default: once its cell is in sight),
	//     "hidden" (once a piece of yours enters it) or {"proximity":n} (once a piece of
	//     yours is within n cells).
	//   pool: what it holds (HP, damage or gold): n, {"min":n, "max":n} (rolled when it's
	//     made) or "infinite".
	//   magnitude: what it gives each piece it affects, each time: n, {"min","max"} or
	//     "pool" (default: all that's left).
	//   showMagnitude: when its magnitude shows, as revealMode ("hidden": once used).
	//   showPool: whether what's left in it shows (default false).
	//   area: who it affects when a piece of yours enters it: a radius (default 0: just
	//     that piece) or {"radius":n, "shape":"flat" | "ring" | "fade"}.
	//   duration: when it's gone: "exhausted" (default: when its pool is empty), "once",
	//     {"count":n} (after n uses) or {"countdown":n} (n turns after it's revealed).
	//   state: {"name":value} (true, false or a number): what each one keeps, its formulas'
	//     variables (with "hp", what it has left).
	//   composition, hp, coverage, floor: as for solids (DR and opacity from the material;
	//     with hp it can be broken, when it's in the way; floor is left under it when it's
	//     gone); coverage may be a formula.
	//   moveCost: what a step onto it costs, times the floor's (default 1), or a formula; 0
	//     or less and it's in the way, as a solid is.
	//   destroyInto: the fixture it leaves when it's gone (broken, used up or run out).
	//   fillColor, borderColor: a feature's colours; shape: how it's drawn, "hex" (default)
	//     or "door".
	//   orientable: true if each one faces a way (front, sides, back: see Fixtures.js).
	//   actions: {"name":{"from":["front", "back", "side"], "when":formula, "set":{"state
	//     name":value or formula}, "onStep":true, "label":"..."}}: what a piece of yours
	//     next to it can do to it (with Use, U), for an action; onStep: what a step into
	//     it does, when it's in the way.
	//   describe: [{"when":formula, "text":"..."}]: words for its state, shown when you
	//     point at it (each whose when holds).
	// Maps choose which kinds of each type they place (their tile generator's attrs; see
	// js/hc/model/map/tile/ProximityTileGenerator.js and CavernsTileGenerator.js).
	"fixtures":{
		// Heals
		"heal": {
			"type":"heal",
			"name":"Heal",
			"description":"Heals the piece that takes it; what it doesn't need flows along its links.",
			"pool":{"min":1, "max":4}
		},
		"spring":{
			"type":"heal",
			"name":"Healing spring", 
			"description":"Heals 1 each time, for as long as it lasts.", 
			"pool":"infinite", 
			"magnitude":1, 
			"duration":{"countdown":10}
		},
		"salve": {
			"type":"heal",
			"name":"Salve",
			"description":"Heals every piece of yours next to it.",
			"pool":6,
			"magnitude":2,
			"area":1,
			"showPool":true
		},
		
		// Harms
		"harm":{
			"type":"harm",
			"name":"Harm",
			"description":"Hurts whatever piece of yours steps on it.",
			"pool":1
		},
		"trap":{
			"type":"harm",
			"name":"Hidden trap",
			"description":"You only find it by stepping on it.",
			"revealMode":"hidden",
			"pool":2
		},
		"mine":{
			"type":"harm",
			"name":"Mine",
			"description":"Blasts every piece around it, less further out.",
			"revealMode":{"proximity":2},
			"pool":"infinite",
			"magnitude":2,
			"area":{"radius":1, "shape":"fade"},
			"duration":"once"
		},
		
		// Loot
		"loot":{
			"type":"loot",
			"name":"Loot",
			"description":"Gold for the taking.",
			"pool":{"min":10, "max":30}
		},
		"cache":{
			"type":"loot",
			"name":"Cache",
			"description":"Buried: you have to be close to find it, and closer to tell what's in it.",
			"revealMode":{"proximity":2},
			"pool":{"min":30, "max":60},
			"showMagnitude":{"proximity":1}
		},
		
		// Features (featureTable in the tile generators' attrs)
		"barricade":{
			"type":"feature",
			"name":"Barricade",
			"description":"Planks nailed across the way.",
			"composition":"pinewood",
			"hp":10,
			"coverage":80,
			"moveCost":0,
			"destroyInto":"broken_barricade",
			"fillColor":"#7a5a3a",
			"borderColor":"#5a4028"
		},
		"broken_barricade":{
			"type":"feature",
			"name":"Broken barricade",
			"description":"What's left of a barricade: slow going.",
			"composition":"pinewood",
			"hp":5,
			"coverage":20,
			"moveCost":1.5,
			"destroyInto":"wood_scraps",
			"fillColor":"#7a5a3a",
			"borderColor":"#5a4028"
		},
		"wooden_door":{
			"type":"feature",
			"name":"Wooden door",
			"description":"A heavy oak door. It can be barred from behind.",
			"shape":"door",
			"orientable":true,
			"composition":"oakwood",
			"hp":15,
			"state":{"open":false, "barred":false},
			"moveCost":"open ? 1 : 0",
			"coverage":"open ? 0 : 100",
			"destroyInto":"broken_door",
			"actions":{
				"open": {"when":"!open && !barred", "set":{"open":true}, "onStep":true},
				"close":{"when":"open", "set":{"open":false}},
				"bar":  {"from":["back"], "when":"!open && !barred", "set":{"barred":true}},
				"unbar":{"from":["back"], "when":"barred", "set":{"barred":false}}
			},
			"describe":[{"when":"open", "text":"open"}, {"when":"!open", "text":"shut"}, {"when":"barred", "text":"barred"}],
			"fillColor":"#753",
			"borderColor":"#532"
		},
		"broken_door":{
			"type":"feature",
			"name":"Broken door",
			"description":"Splintered oak: slow going.",
			"composition":"oakwood",
			"coverage":20,
			"moveCost":1.5,
			"fillColor":"#6b4a2b",
			"borderColor":"#4a3220"
		},
		"wood_scraps":{
			"type":"feature",
			"name":"Wood Scraps",
			"description":"Scraps of wood.",
			"composition":"pinewood",
			"coverage":0,
			"fillColor":"#7536",
		},
		
		// Containers: features with an "inventory" (see js/hc/model/tile/Fixtures.js), and
		// maybe "contents" (what each starts with) and "access" (when what's in it can be
		// got at). Your pieces can get at what's in one on their cell or next to it.
		"chest":{
			"type":"feature",
			"name":"Chest",
			"description":"A heavy oak chest. Open it to get at what's inside.",
			"composition":"oakwood",
			"hp":20,
			"coverage":40,
			"moveCost":0,
			"state":{"open":false},
			"actions":{
				"open": {"when":"!open", "set":{"open":true}},
				"close":{"when":"open", "set":{"open":false}}
			},
			"describe":[{"when":"open", "text":"open"}, {"when":"!open", "text":"shut"}],
			"access":"open",
			"inventory":{"capacity":20, "volume":150000},
			"contents":[
				{"kind":"gold_coin", "count":[0, 40]},
				{"kind":"dagger", "count":[0, 1]},
				{"kind":"short_sword", "count":[0, 1]},
				{"kind":"belt_pouch", "count":[0, 1]},
				{"kind":"leather_armor", "count":[0, 1]},
				{"kind":"iron_helm", "count":[0, 1]}
			],
			"destroyInto":"wood_scraps",
			"fillColor":"#8a5a2b",
			"borderColor":"#c9a46b"
		},
		"cabinet":{
			"type":"feature",
			"name":"Cabinet",
			"description":"A tall oak cabinet with doors.",
			"composition":"oakwood",
			"hp":15,
			"coverage":70,
			"moveCost":0,
			"state":{"open":false},
			"actions":{
				"open": {"when":"!open", "set":{"open":true}},
				"close":{"when":"open", "set":{"open":false}}
			},
			"describe":[{"when":"open", "text":"open"}, {"when":"!open", "text":"shut"}],
			"access":"open",
			"inventory":{"capacity":12, "volume":200000},
			"contents":[
				{"kind":"mushroom_jerky", "count":[0, 6]},
				{"kind":"centipede_jerky", "count":[0, 6]},
				{"kind":"club", "count":[0, 1]},
				{"kind":"wooden_shield", "count":[0, 1]},
				{"kind":"leather_gloves", "count":[0, 1]},
				{"kind":"leather_boots", "count":[0, 1]},
				{"kind":"chain_shirt", "count":[0, 1]},
				{"kind":"flask", "count":[0, 1], "contents":[{"kind":"water", "count":250}]}
			],
			"destroyInto":"wood_scraps",
			"fillColor":"#6b4524",
			"borderColor":"#b08850"
		},
		"table":{
			"type":"feature",
			"name":"Table",
			"description":"A rough pine table: slow to climb over. What's on it is there for the taking.",
			"composition":"pinewood",
			"hp":10,
			"coverage":30,
			"moveCost":2,
			"inventory":{"capacity":6, "volume":100000},
			"contents":[
				{"kind":"mushroom_jerky", "count":[0, 3]},
				{"kind":"gold_coin", "count":[0, 10]}
			],
			"destroyInto":"wood_scraps",
			"fillColor":"#9a7448",
			"borderColor":"#5a4028"
		}
	}
}
