#!/bin/sh
# Stops a commit that fails lint or the startup checks: a few seconds' work. Run the
# full suite with "npm test" before pushing.
#
# Turn it on once per clone with "npm run setup-hooks". Skip it for one commit with
# "git commit --no-verify".

echo "pre-commit: lint"
if ! npm run --silent lint; then
    echo "pre-commit: lint failed, so the commit was stopped. (git commit --no-verify skips this.)"
    exit 1
fi

echo "pre-commit: startup checks"
if ! npx playwright test tests/startup.spec.mjs --reporter=dot; then
    echo "pre-commit: the startup checks failed, so the commit was stopped. (git commit --no-verify skips this.)"
    exit 1
fi
